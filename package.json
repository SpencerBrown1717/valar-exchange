{
  "name": "valar-exchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/research.mjs validate && tsc --noEmit && vite build && node scripts/build-routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run research:validate && npm run build",
    "research:validate": "node scripts/research.mjs validate",
    "research:generate": "node scripts/research.mjs generate",
    "research:pause": "node scripts/research.mjs pause",
    "research:edit": "node scripts/research.mjs edit",
    "research:remove": "node scripts/research.mjs remove"
  },
  "dependencies": { "@fontsource-variable/inter": "5.3.0" },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
